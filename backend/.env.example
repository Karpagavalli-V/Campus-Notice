# =============================================
# Campus Notice — Backend Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env to source control.

# Server
NODE_ENV=development           # "development" | "production"
PORT=5000

# Database
MONGO_URI=your_mongodb_connection_string

# Authentication
JWT_SECRET=your_strong_jwt_secret_min_32_chars

# Frontend URL(s) — used for CORS and password-reset emails
# In production, add your deployed frontend URL (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000

# Email (Gmail — use App Passwords, not your account password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
