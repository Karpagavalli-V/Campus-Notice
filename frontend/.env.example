# ================================================
# Campus Notice — Frontend Environment Variables
# ================================================
# Copy this file to .env and fill in the values.
# React only exposes variables prefixed with REACT_APP_
# NEVER commit your actual .env to source control.

# Backend API base URL (no trailing slash, no /api suffix)
# Development:  http://localhost:5000
# Production:   https://campus-notice-8s0b.onrender.com
REACT_APP_API_URL=http://localhost:5000
